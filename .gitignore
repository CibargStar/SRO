.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo

# Prisma
# ВАЖНО: Миграции (migrations/) должны быть в репозитории для воспроизводимости!
# Игнорируем только файлы БД (данные), НЕ миграции (код)
backend/prisma/**/*.db
backend/prisma/**/*.db-journal
backend/prisma/test.db
# Игнорируем БД файлы в корне prisma (если есть)
backend/prisma/*.db
backend/prisma/*.db-journal

# Docker
.dockerignore

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.cache/
.temp/
.tmp/

# Cursor IDE
.cursor/

# Uploads (user-uploaded files)
uploads/
backend/uploads/
frontend/uploads/

# Profiles directories (Chrome profile data, NOT source code)
# ВАЖНО: Профили хранятся в системной папке для обхода ограничения Windows (260 символов)
# Windows: C:\SROProf
# Linux/Mac: ~/.sroprof
# Игнорируем только папки с данными профилей в корне проекта, НЕ исходный код модуля!
/profiles/
/backend/profiles/
/backend/prof/
/prof/
# Явно разрешаем исходный код модуля profiles
!backend/src/modules/profiles/

